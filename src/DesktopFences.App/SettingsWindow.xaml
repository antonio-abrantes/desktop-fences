<Window x:Class="DesktopFences.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopFences"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="460"
        SizeToContent="Height"
        MinWidth="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="88"/>
        </Style>
        <Style x:Key="HintLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="8"
            BorderBrush="#4DFFFFFF"
            BorderThickness="1"
            Background="#F20C0C12"
            ClipToBounds="True">
        <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Height="44"
                    Background="#33000000"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeading"
                                   Foreground="#F2FFFFFF"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtTitleSuffix"
                                   Foreground="#73FFFFFF"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnAbout"
                                Content="?"
                                Width="36" Height="32"
                                Style="{StaticResource GhostIconButton}"
                                Click="About_Click"/>
                        <Button x:Name="BtnClose"
                                Content="✕"
                                Width="36" Height="32"
                                Style="{StaticResource GhostIconButton}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <CheckBox x:Name="StartWithWindows"
                              Foreground="#F2FFFFFF"
                              Margin="0,8,0,4"
                              VerticalAlignment="Center"
                              Checked="StartWithWindows_Changed"
                              Unchecked="StartWithWindows_Changed"/>
                    <TextBlock x:Name="TxtStartupHint"
                               Style="{StaticResource HintLabel}"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="TxtLanguage"
                               Style="{StaticResource HintLabel}"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboLanguage"
                              Margin="0,0,0,16"
                              MaxWidth="220"
                              HorizontalAlignment="Left"
                              SelectionChanged="Language_Changed">
                        <ComboBoxItem Tag="system"/>
                        <ComboBoxItem Tag="pt"/>
                        <ComboBoxItem Tag="en"/>
                    </ComboBox>

                    <TextBlock x:Name="TxtFolders"
                               Style="{StaticResource HintLabel}"
                               Margin="0,0,0,8"/>
                    <Button x:Name="BtnOpenLayout"
                            Style="{StaticResource FenceButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,4"
                            Click="OpenLayout_Click"/>
                    <TextBox x:Name="TxtLayoutPath"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#B3FFFFFF"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10"
                             Cursor="IBeam"/>
                    <Button x:Name="BtnOpenItems"
                            Style="{StaticResource FenceButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,4"
                            Click="OpenItems_Click"/>
                    <TextBox x:Name="TxtItemsPath"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#B3FFFFFF"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Cursor="IBeam"/>
            </StackPanel>

            <Grid DockPanel.Dock="Bottom" Margin="16,8,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnResetTheme"
                        Grid.Column="0"
                        Style="{StaticResource FenceButton}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,8,0"
                        Click="ResetTheme_Click"/>
                <Button x:Name="BtnSetDefaultLayout"
                        Grid.Column="1"
                        Style="{StaticResource FenceButton}"
                        HorizontalAlignment="Stretch"
                        Margin="0"
                        Click="SetDefaultLayout_Click"/>
            </Grid>

            <StackPanel Margin="16,12,16,8">
                    <TextBlock x:Name="TxtFenceListLabel"
                               Style="{StaticResource HintLabel}"
                               Margin="0,0,0,8"/>
                    <Grid MinHeight="72" MaxHeight="148">
                    <ListBox x:Name="FenceList"
                             Background="#22000000"
                             BorderBrush="#33FFFFFF"
                             BorderThickness="1"
                             Foreground="#F2FFFFFF"
                             Padding="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="FenceList_SelectionChanged">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource FenceScrollBar}"/>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="#18FFFFFF"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#335B8DEF"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#CC5B8DEF"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AlignmentLabel}"
                                               Foreground="#73FFFFFF"
                                               FontSize="11"
                                               Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnNewFence"
                                Grid.Column="0"
                                Style="{StaticResource FenceButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,8,0"
                                Click="AddFence_Click"/>
                        <Button x:Name="BtnRemove"
                                Grid.Column="1"
                                Style="{StaticResource FenceButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0"
                                Click="RemoveFence_Click"/>
                    </Grid>

                    <CheckBox x:Name="ApplyAllCheck"
                              Foreground="#F2FFFFFF"
                              Margin="0,16,0,4"
                              VerticalAlignment="Center"
                              Checked="ApplyAllCheck_Changed"
                              Unchecked="ApplyAllCheck_Changed"/>
                    <TextBlock x:Name="TxtApplyAllHint"
                               Style="{StaticResource HintLabel}"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="TxtAlignLabel"
                               Style="{StaticResource HintLabel}"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="AlignLeft"
                                     GroupName="TitleAlign"
                                     Foreground="#F2FFFFFF"
                                     Margin="0,0,20,0"
                                     VerticalAlignment="Center"
                                     Checked="AlignLeft_Checked"/>
                        <RadioButton x:Name="AlignCenter"
                                     GroupName="TitleAlign"
                                     Foreground="#F2FFFFFF"
                                     VerticalAlignment="Center"
                                     Checked="AlignCenter_Checked"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtAppearance"
                               Style="{StaticResource HintLabel}"
                               Margin="0,12,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtFill" Style="{StaticResource FieldLabel}"/>
                        <Border x:Name="SwatchFill" Grid.Column="1" Style="{StaticResource Swatch}"
                                MouseLeftButtonDown="SwatchFill_Click"/>
                        <Slider x:Name="SliderFill"
                                Grid.Column="2"
                                Minimum="45" Maximum="85"
                                SmallChange="1" LargeChange="5"
                                VerticalAlignment="Center"
                                Margin="12,0,8,0"
                                ValueChanged="SliderFill_Changed"/>
                        <TextBlock x:Name="LblFillPct" Grid.Column="3" Foreground="#73FFFFFF" FontSize="11"
                                   VerticalAlignment="Center" Text="66%"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtBorder" Style="{StaticResource FieldLabel}"/>
                        <Border x:Name="SwatchBorder" Grid.Column="1" Style="{StaticResource Swatch}"
                                MouseLeftButtonDown="SwatchBorder_Click"/>
                        <Slider x:Name="SliderBorder"
                                Grid.Column="2"
                                Minimum="15" Maximum="100"
                                SmallChange="1" LargeChange="5"
                                VerticalAlignment="Center"
                                Margin="12,0,8,0"
                                ValueChanged="SliderBorder_Changed"/>
                        <TextBlock x:Name="LblBorderPct" Grid.Column="3" Foreground="#73FFFFFF" FontSize="11"
                                   VerticalAlignment="Center" Text="30%"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtHeader" Style="{StaticResource FieldLabel}"/>
                        <Border x:Name="SwatchHeader" Grid.Column="1" Style="{StaticResource Swatch}"
                                MouseLeftButtonDown="SwatchHeader_Click"/>
                        <Slider x:Name="SliderHeader"
                                Grid.Column="2"
                                Minimum="15" Maximum="85"
                                SmallChange="1" LargeChange="5"
                                VerticalAlignment="Center"
                                Margin="12,0,8,0"
                                ValueChanged="SliderHeader_Changed"/>
                        <TextBlock x:Name="LblHeaderPct" Grid.Column="3" Foreground="#73FFFFFF" FontSize="11"
                                   VerticalAlignment="Center" Text="20%"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtText" Style="{StaticResource FieldLabel}"/>
                        <Border x:Name="SwatchText" Grid.Column="1" Style="{StaticResource Swatch}"
                                MouseLeftButtonDown="SwatchText_Click"/>
                    </Grid>
            </StackPanel>
        </DockPanel>
        <Border x:Name="ReturnOverlay"
                Visibility="Collapsed"
                Background="#CC0C0C12"
                CornerRadius="8">
            <TextBlock x:Name="TxtReturnOverlay"
                       Style="{StaticResource HintLabel}"
                       Foreground="#F2FFFFFF"
                       FontSize="13"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="24"
                       TextWrapping="Wrap"/>
        </Border>
        </Grid>
    </Border>
</Window>
