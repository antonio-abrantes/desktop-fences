<Window x:Class="DesktopFences.Recovery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopFences Recovery"
        Width="620" Height="420"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#11131A"
        Foreground="#F2FFFFFF">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" FontSize="26" FontWeight="SemiBold" />
        <TextBlock x:Name="ExplanationText" Grid.Row="1" Margin="0,20,0,0"
                   FontSize="15" TextWrapping="Wrap" LineHeight="23" />
        <Border Grid.Row="2" Margin="0,20,0,0" Padding="14"
                Background="#2A332300" BorderBrush="#99E6B94A" BorderThickness="1" CornerRadius="8">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="#FFFFD77A" />
        </Border>
        <StackPanel Grid.Row="3" Margin="0,22,0,0">
            <CheckBox x:Name="RestorePositionsCheckBox"
                      Foreground="#F2FFFFFF"
                      Margin="0,0,0,16" />
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap" Foreground="#BFD7E6FF" />
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" MinWidth="100" Height="38" Margin="0,0,12,0" Click="Close_Click" />
            <Button x:Name="RestoreButton" MinWidth="210" Height="38" FontWeight="SemiBold" Click="Restore_Click" />
        </StackPanel>
    </Grid>
</Window>
